@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl">
        <div class="card stat-card shadow-sm">
            <div class="card-body">
                <div class="stat-label">Total Sales</div>
                <div class="stat-value">Rs. 450,000</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="card stat-card shadow-sm">
            <div class="card-body">
                <div class="stat-label">Total Purchases</div>
                <div class="stat-value">Rs. 280,000</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="card stat-card shadow-sm">
            <div class="card-body">
                <div class="stat-label">Income</div>
                <div class="stat-value">Rs. 170,000</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="card stat-card shadow-sm">
            <div class="card-body">
                <div class="stat-label">Expenses</div>
                <div class="stat-value">Rs. 60,000</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="card stat-card stat-card-accent shadow-sm">
            <div class="card-body">
                <div class="stat-label">Outstanding Balance</div>
                <div class="stat-value">Rs. 95,000</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold">Recent Transactions</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>#</th><th>Date</th><th>Party</th><th>Type</th><th class="text-end">Amount</th><th>Status</th></tr>
            </thead>
            <tbody>
                <tr><td>1001</td><td>2026-11-08</td><td>Ali Traders</td><td>Sale</td><td class="text-end">Rs. 25,000</td><td><span class="badge bg-success">Paid</span></td></tr>
                <tr><td>1002</td><td>2026-11-08</td><td>Noor Supplies</td><td>Purchase</td><td class="text-end">Rs. 40,000</td><td><span class="badge bg-warning text-dark">Pending</span></td></tr>
                <tr><td>1003</td><td>2026-11-07</td><td>Hassan Store</td><td>Payment</td><td class="text-end">Rs. 10,000</td><td><span class="badge bg-success">Paid</span></td></tr>
                <tr><td>1004</td><td>2026-11-06</td><td>Sara Mart</td><td>Sale (Credit)</td><td class="text-end">Rs. 18,500</td><td><span class="badge bg-danger">Unpaid</span></td></tr>
                <tr><td>1005</td><td>2026-11-05</td><td>City Wholesale</td><td>Purchase</td><td class="text-end">Rs. 62,000</td><td><span class="badge bg-success">Paid</span></td></tr>
            </tbody>
        </table>
    </div>
</div>