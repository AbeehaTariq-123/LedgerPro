@model LedgerPro.Models.Product
@{
    var isNew = Model.ProductId == 0;
    ViewData["Title"] = isNew ? "Add Product" : "Edit Product";
    ViewData["Subtitle"] = isNew ? "Add an item to your catalogue" : "Update product details";
}

<div class="section-card form-card">
    <form asp-action="Save" method="post">
        <input type="hidden" asp-for="ProductId" />
        <div asp-validation-summary="ModelOnly" class="field-error"></div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="ProductName">Product name</label>
                <input asp-for="ProductName" class="form-control" required />
                <span asp-validation-for="ProductName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="SKU">SKU</label>
                <input asp-for="SKU" class="form-control" required />
                <span asp-validation-for="SKU" class="field-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="PurchasePrice">Purchase price (PKR)</label>
                <input asp-for="PurchasePrice" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="PurchasePrice" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="SalePrice">Sale price (PKR)</label>
                <input asp-for="SalePrice" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="SalePrice" class="field-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="StockQuantity">Stock quantity</label>
                <input asp-for="StockQuantity" type="number" step="0.001" min="0" class="form-control" />
                <span asp-validation-for="StockQuantity" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="ReorderLevel">Reorder level</label>
                <input asp-for="ReorderLevel" type="number" step="0.001" min="0" class="form-control" />
                <span asp-validation-for="ReorderLevel" class="field-error"></span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Product</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>
