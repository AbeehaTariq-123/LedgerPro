@model LedgerPro.Models.ViewModels.PaymentFormViewModel
@{
    bool received = Model.PaymentType == "Received";
    ViewData["Title"] = received ? "Receive Payment" : "Pay Supplier";
    ViewData["Subtitle"] = received ? "Record money received from a customer" : "Record money paid to a supplier";
}

<div class="section-card form-card">
    <div class="segmented">
        <a asp-action="Create" asp-route-type="Received" class="@(received ? "active" : "")">From customer</a>
        <a asp-action="Create" asp-route-type="Paid" class="@(!received ? "active" : "")">To supplier</a>
    </div>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="PaymentType" />
        <div asp-validation-summary="ModelOnly" class="field-error"></div>

        <div class="form-group">
            <label class="form-label" asp-for="PartyId">@(received ? "Customer" : "Supplier")</label>
            <select asp-for="PartyId" asp-items="Model.Parties" class="form-control" required>
                <option value="">— Select —</option>
            </select>
            <span asp-validation-for="PartyId" class="field-error"></span>
            @if (!Model.Parties.Any())
            {
                <span class="field-error">
                    No @(received ? "customers" : "suppliers") yet —
                    <a asp-controller="@(received ? "Customer" : "Supplier")" asp-action="Create">add one first</a>.
                </span>
            }
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="Amount">Amount (PKR)</label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required />
                <span asp-validation-for="Amount" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="PaymentDate">Date</label>
                <input asp-for="PaymentDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required />
                <span asp-validation-for="PaymentDate" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Description">Note</label>
            <textarea asp-for="Description" class="form-control" placeholder="Cash, bank transfer, cheque no.…"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Payment</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>
