<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LedgerPro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@500;700&family=Great+Vibes&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/ledgerpro.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <nav class="sidebar d-none d-md-flex flex-column p-3">
            <a asp-controller="Home" asp-action="Index" class="brand text-decoration-none mb-4">
                <span class="brand-script">The</span> <span class="brand-main">LEDGER PRO</span>
            </a>
            <ul class="nav nav-pills flex-column gap-1">
                <li><a class="nav-link active" href="#"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                <li><a class="nav-link" href="#"><i class="bi bi-people me-2"></i>Customers</a></li>
                <li><a class="nav-link" href="#"><i class="bi bi-truck me-2"></i>Suppliers</a></li>
                <li><a class="nav-link" href="#"><i class="bi bi-box-seam me-2"></i>Products</a></li>
                <li><a class="nav-link" href="#"><i class="bi bi-cart-check me-2"></i>Sales</a></li>
                <li><a class="nav-link" href="#"><i class="bi bi-bag me-2"></i>Purchases</a></li>
                <li><a class="nav-link" href="#"><i class="bi bi-cash-coin me-2"></i>Payments</a></li>
                <li><a class="nav-link" href="#"><i class="bi bi-book me-2"></i>Ledger</a></li>
                <li><a class="nav-link" href="#"><i class="bi bi-receipt me-2"></i>Invoices</a></li>
                <li><a class="nav-link" href="#"><i class="bi bi-bar-chart-line me-2"></i>Reports</a></li>
            </ul>
        </nav>

        <div class="flex-grow-1 main-area">
            <header class="topbar d-flex justify-content-between align-items-center px-4 py-3">
                <h5 class="page-title mb-0">@ViewData["Title"]</h5>
                <div class="d-flex align-items-center gap-3">
                    <span class="user-chip">
                        <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                        <span class="badge badge-role ms-1">@(User.IsInRole("Admin") ? "Admin" : "Staff")</span>
                    </span>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="mb-0">
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </button>
                    </form>
                </div>
            </header>
            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>