@using LedgerPro.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = currentUser?.Email ?? "Administrator";
    }

    var initials = string.Join(
        "",
        displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => x[0])
    ).ToUpperInvariant();

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "AD";
    }
}

@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var txType = Context.Request.Query["type"].ToString().ToLowerInvariant();
    Func<string, string> Active = c => ctrl == c ? "active" : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LedgerPro Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Nunito:wght@400;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/pages.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="dashboard-shell">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <div class="brand-icon">🪶</div>

                <div>
                    <h3>LedgerPro</h3>
                    <span>Admin Panel</span>
                </div>
            </div>

            <nav class="sidebar-nav">

                <a href="/Dashboard/Admin" class="nav-item @Active("Dashboard")">
                    <span>📊</span> Dashboard
                </a>

                <a href="/Customer" class="nav-item @Active("Customer")">
                    <span>👥</span> Customers
                </a>

                <a href="/Supplier" class="nav-item @Active("Supplier")">
                    <span>🏷️</span> Suppliers
                </a>

                <a href="/Product" class="nav-item @Active("Product")">
                    <span>📦</span> Products
                </a>

                <a href="/Transaction" class="nav-item @Active("Transaction")">
                    <span>💳</span> Transactions
                </a>

                <a href="/Payment" class="nav-item @Active("Payment")">
                    <span>💰</span> Payments
                </a>

                <a href="/Invoice" class="nav-item @Active("Invoice")">
                    <span>🧾</span> Invoices
                </a>

                <a href="/Report" class="nav-item @Active("Report")">
                    <span>📈</span> Reports
                </a>

            </nav>

            <div class="sidebar-footer">

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="nav-item logout"
                            style="width:100%; border:0; background:none; text-align:left; cursor:pointer;">

                        <span>↩</span> Logout

                    </button>

                </form>

            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- TOPBAR -->
            <header class="topbar">

                <div>
                    <h2 class="page-title">@ViewData["Title"]</h2>
                    <p class="page-subtitle">@ViewData["Subtitle"]</p>
                </div>

                <div class="topbar-right">

                    <button class="icon-btn" type="button" title="Notifications">
                        🔔
                    </button>

                    <div class="profile-chip">

                        <div class="avatar">
                            @initials
                        </div>

                        <div>
                            <strong>@displayName</strong>
                            <span>Administrator</span>
                        </div>

                    </div>

                </div>

            </header>

            <!-- PAGE CONTENT -->
            <div class="content-body">
                <partial name="_Alerts" />
                @RenderBody()
            </div>

        </main>

    </div>

    <script>window.LedgerPro = { isAdmin: @(User.IsInRole("Admin") ? "true" : "false") };</script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>