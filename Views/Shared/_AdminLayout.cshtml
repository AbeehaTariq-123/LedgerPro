<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LedgerPro Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <div class="dashboard-shell">
        
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">🪶</div>
                <div>
                    <h3>LedgerPro</h3>
                    <span>Admin Panel</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a href="/Dashboard/Admin" class="nav-item active"><span>📊</span> Dashboard</a>
                <a href="/Customer" class="nav-item"><span>👥</span> Customers</a>
                <a href="/Supplier" class="nav-item"><span>🏷️</span> Suppliers</a>
                <a href="/Product" class="nav-item"><span>📦</span> Products</a>
                <a href="/Transaction" class="nav-item"><span>💳</span> Transactions</a>
                <a href="/Payment" class="nav-item"><span>💰</span> Payments</a>
                <a href="/Invoice" class="nav-item"><span>🧾</span> Invoices</a>
                <a href="/Report" class="nav-item"><span>📈</span> Reports</a>
            </nav>

            <div class="sidebar-footer">
                <a href="/Account/Logout" class="nav-item logout"><span>↩</span> Logout</a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <header class="topbar">
                <div>
                    <h2 class="page-title">@ViewData["Title"]</h2>
                    <p class="page-subtitle">@ViewData["Subtitle"]</p>
                </div>
                <div class="topbar-right">
                    <button class="icon-btn" title="Notifications">🔔</button>
                    <div class="profile-chip">
                        <div class="avatar">AT</div>
                        <div>
                            <strong>@Context.Session.GetString("UserName")</strong>
                            <span>@Context.Session.GetString("UserRole")</span>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-body">
                @RenderBody()
            </div>
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>