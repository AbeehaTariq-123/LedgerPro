@model LedgerPro.Models.ViewModels.LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<div class="auth-form-header">
    <h2>Welcome back</h2>
    <p>Sign in to your LedgerPro account to continue.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="auth-alert success">@TempData["Success"]</div>
}

<div asp-validation-summary="ModelOnly"
     class="auth-alert error"
     role="alert"></div>

<form asp-action="Login"
      asp-controller="Account"
      asp-route-returnUrl="@ViewData["ReturnUrl"]"
      method="post"
      id="loginForm">

    @Html.AntiForgeryToken()

    <div class="form-group">
        <label class="form-label" asp-for="Email">
            Email Address
        </label>

        <input asp-for="Email"
               class="form-control"
               placeholder="you@example.com"
               autocomplete="username" />

        <span asp-validation-for="Email"
              class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="AccountType">
            Account Type
        </label>

        <select asp-for="AccountType" class="form-control">
            <option value="Staff">Staff</option>
            <option value="Admin">Admin</option>
        </select>

        <span asp-validation-for="AccountType"
              class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="Password">
            Password
        </label>

        <div class="password-wrapper">
            <input asp-for="Password"
                   type="password"
                   class="form-control"
                   placeholder="Enter your password"
                   autocomplete="current-password"
                   id="passwordInput" />

            <button type="button"
                    class="toggle-password"
                    onclick="togglePassword('passwordInput', this)"
                    title="Show/hide password">
                👁
            </button>
        </div>

        <span asp-validation-for="Password"
              class="field-error"></span>
    </div>

    <div class="auth-options">
        <label class="checkbox-label">
            <input asp-for="RememberMe" />
            Remember me
        </label>

        <a asp-area="Identity"
           asp-page="/Account/ForgotPassword">
            Forgot password?
        </a>
    </div>

    <button type="submit"
            class="btn btn-primary auth-submit">
        Sign In
    </button>

    <div class="divider-text">New to LedgerPro?</div>

    <p class="auth-footer-text">
        Don't have an account?
        <a asp-action="Signup" asp-controller="Account">
            Create one now
        </a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
