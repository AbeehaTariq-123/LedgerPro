@model LedgerPro.Models.ViewModels.SignupViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create Account";
}

<div class="auth-form-header">
    <h2>Create your account</h2>
    <p>Start managing your business ledger in a beautiful way.</p>
</div>

<div asp-validation-summary="ModelOnly"
     class="auth-alert error"
     role="alert"></div>

<form asp-action="Signup"
      asp-controller="Account"
      method="post"
      id="signupForm">

    @Html.AntiForgeryToken()

    <div class="form-group">
        <label class="form-label" asp-for="FullName">
            Full Name
        </label>

        <input asp-for="FullName"
               class="form-control"
               placeholder="Jane Doe"
               autocomplete="name" />

        <span asp-validation-for="FullName"
              class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="Email">
            Email Address
        </label>

        <input asp-for="Email"
               class="form-control"
               placeholder="you@example.com"
               autocomplete="email" />

        <span asp-validation-for="Email"
              class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="AccountType">
            Account Type
        </label>

        <select asp-for="AccountType"
                class="form-control"
                id="accountType">

            <option value="Staff">Staff</option>
            <option value="Admin">Admin</option>
        </select>

        <span asp-validation-for="AccountType"
              class="field-error"></span>
    </div>

    <div class="form-group"
         id="adminCodeGroup"
         style="display:none;">

        <label class="form-label"
               asp-for="AdminRegistrationCode">
            Admin Registration Code
        </label>

        <input asp-for="AdminRegistrationCode"
               type="password"
               class="form-control"
               placeholder="Enter Admin registration code"
               autocomplete="off" />

        <span asp-validation-for="AdminRegistrationCode"
              class="field-error"></span>

        <small class="text-muted">
            An authorized Admin registration code is required.
        </small>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="Password">
            Password
        </label>

        <div class="password-wrapper">
            <input asp-for="Password"
                   type="password"
                   class="form-control"
                   placeholder="At least 8 characters"
                   autocomplete="new-password"
                   id="signupPwd" />

            <button type="button"
                    class="toggle-password"
                    onclick="togglePassword('signupPwd', this)"
                    title="Show/hide password">
                👁
            </button>
        </div>

        <span asp-validation-for="Password"
              class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="ConfirmPassword">
            Confirm Password
        </label>

        <div class="password-wrapper">
            <input asp-for="ConfirmPassword"
                   type="password"
                   class="form-control"
                   placeholder="Repeat your password"
                   autocomplete="new-password"
                   id="signupConfirm" />

            <button type="button"
                    class="toggle-password"
                    onclick="togglePassword('signupConfirm', this)"
                    title="Show/hide password">
                👁
            </button>
        </div>

        <span asp-validation-for="ConfirmPassword"
              class="field-error"></span>
    </div>

    <button type="submit"
            class="btn btn-primary auth-submit">
        Create Account
    </button>

    <p class="auth-footer-text mt-3">
        Already have an account?
        <a asp-action="Login" asp-controller="Account">
            Sign in
        </a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const accountType =
                document.getElementById("accountType");

            const adminCodeGroup =
                document.getElementById("adminCodeGroup");

            function updateAdminCodeVisibility() {
                if (accountType.value === "Admin") {
                    adminCodeGroup.style.display = "block";
                } else {
                    adminCodeGroup.style.display = "none";
                }
            }

            accountType.addEventListener(
                "change",
                updateAdminCodeVisibility
            );

            updateAdminCodeVisibility();
        });
    </script>
}
