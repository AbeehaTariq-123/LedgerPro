@page
@model LockoutModel
@{
    ViewData["Title"] = "Account Locked";
}

<div class="auth-form-header">
    <h2>Account locked</h2>
    <p>Too many failed sign-in attempts. Please try again in 15 minutes.</p>
</div>

<a asp-page="./Login" class="btn btn-primary auth-submit" style="text-align:center;text-decoration:none;display:block;">Back to Login</a>
