@page
@model RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-form-header">
    <h2>Create your account</h2>
    <p>Start managing your business ledger in a beautiful way.</p>
</div>

<div asp-validation-summary="ModelOnly" class="auth-alert error" role="alert"></div>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" id="signupForm">

    <div class="form-group">
        <label class="form-label" asp-for="Input.FullName">Full Name</label>
        <input asp-for="Input.FullName" class="form-control" placeholder="Jane Doe" autocomplete="name" required />
        <span asp-validation-for="Input.FullName" class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="Input.Email">Email Address</label>
        <input asp-for="Input.Email" class="form-control" placeholder="you@example.com" autocomplete="email" required />
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="Input.AccountType">Account Type</label>
        <select asp-for="Input.AccountType" class="form-control" id="accountType">
            <option value="Staff">Staff</option>
            <option value="Admin">Admin</option>
        </select>
        <span asp-validation-for="Input.AccountType" class="field-error"></span>
    </div>

    <div class="form-group" id="adminCodeGroup" style="display:none;">
        <label class="form-label" asp-for="Input.AdminRegistrationCode">Admin Registration Code</label>
        <input asp-for="Input.AdminRegistrationCode" type="password" class="form-control"
               placeholder="Enter Admin registration code" autocomplete="off" />
        <span asp-validation-for="Input.AdminRegistrationCode" class="field-error"></span>
        <small class="text-muted">An authorized Admin registration code is required.</small>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="Input.Password">Password</label>
        <div class="password-wrapper">
            <input asp-for="Input.Password" type="password" class="form-control" id="signupPwd"
                   placeholder="At least 8 characters" autocomplete="new-password" required />
            <button type="button" class="toggle-password" onclick="togglePassword('signupPwd', this)" title="Show/hide password">👁</button>
        </div>
        <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="Input.ConfirmPassword">Confirm Password</label>
        <div class="password-wrapper">
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" id="signupConfirm"
                   placeholder="Repeat your password" autocomplete="new-password" required />
            <button type="button" class="toggle-password" onclick="togglePassword('signupConfirm', this)" title="Show/hide password">👁</button>
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary auth-submit">Create Account</button>

    <p class="auth-footer-text mt-3">
        Already have an account?
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
    </p>
</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const accountType = document.getElementById("accountType");
            const adminCodeGroup = document.getElementById("adminCodeGroup");

            function update() {
                adminCodeGroup.style.display = accountType.value === "Admin" ? "block" : "none";
            }

            accountType.addEventListener("change", update);
            update();
        });
    </script>
}
