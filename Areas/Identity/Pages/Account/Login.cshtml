@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-form-header">
    <h2>Welcome back</h2>
    <p>Sign in to your LedgerPro account to continue.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="auth-alert success">@TempData["Success"]</div>
}

<div asp-validation-summary="ModelOnly" class="auth-alert error" role="alert"></div>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" id="loginForm">

    <div class="form-group">
        <label class="form-label" asp-for="Input.Email">Email Address</label>
        <input asp-for="Input.Email" class="form-control" placeholder="you@example.com" autocomplete="username" required />
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="Input.AccountType">Account Type</label>
        <select asp-for="Input.AccountType" class="form-control">
            <option value="Staff">Staff</option>
            <option value="Admin">Admin</option>
        </select>
        <span asp-validation-for="Input.AccountType" class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label" asp-for="Input.Password">Password</label>
        <div class="password-wrapper">
            <input asp-for="Input.Password" type="password" class="form-control" id="passwordInput"
                   placeholder="Enter your password" autocomplete="current-password" required />
            <button type="button" class="toggle-password" onclick="togglePassword('passwordInput', this)" title="Show/hide password">👁</button>
        </div>
        <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>

    <div class="auth-options">
        <label class="checkbox-label">
            <input asp-for="Input.RememberMe" />
            Remember me
        </label>
    </div>

    <button type="submit" class="btn btn-primary auth-submit">Sign In</button>

    <div class="divider-text">New to LedgerPro?</div>

    <p class="auth-footer-text">
        Don't have an account?
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one now</a>
    </p>
</form>
