@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="auth-form-header">
    <h2>Access Denied</h2>
    <p>You do not have permission to access this page.</p>
</div>

<a asp-page="./Login" class="btn btn-primary auth-submit" style="text-align:center;text-decoration:none;display:block;">Return to Login</a>
